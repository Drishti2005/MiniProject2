[flake8]
# Flake8 configuration for Sidekick Medical Assistant
# More lenient during initial development

max-line-length = 100
exclude = 
    __pycache__,
    *.pyc,
    .git,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info

# Ignore these errors during skeleton code phase
extend-ignore = 
    E501,  # Line too long (handled by max-line-length)
    W503,  # Line break before binary operator
    E203,  # Whitespace before ':'
    F401,  # Module imported but unused
    F811,  # Redefinition of unused name
    E402,  # Module level import not at top of file
    
# Per-file ignores
per-file-ignores =
    __init__.py:F401
    */tests/*:F401,F811

# Show source code for each error
show-source = True

# Count errors
count = True

# Show statistics
statistics = True
