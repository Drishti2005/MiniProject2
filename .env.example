# Sidekick Medical Assistant - Environment Variables
# Copy this file to .env and fill in your actual keys

# Google Gemini API key — get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Which AI provider to use: gemini or groq
AI_PROVIDER=groq

# Database — SQLite for local dev
DATABASE_URL=sqlite+aiosqlite:///sidekick.db

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO